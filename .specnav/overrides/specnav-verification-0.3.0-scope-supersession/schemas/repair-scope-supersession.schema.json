{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specnav.dev/schemas/verification/v2/repair-scope-supersession.schema.json",
  "title": "SpecNav Verification 2.0 Repair Scope Supersession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "failure_id",
    "change_id",
    "classification",
    "review_id",
    "review_digest",
    "reviewer",
    "reviewed_at",
    "reason",
    "proposal_sha256",
    "original_requested_envelope_digest",
    "original_started_envelope_digest",
    "original_baseline_envelope_digest",
    "current_git_revision",
    "approved_snapshot_id",
    "approved_snapshot_hash",
    "replacement_scope_digest",
    "superseded_repair_link"
  ],
  "properties": {
    "schema": {
      "const": "specnav.verification.repair-scope-supersession.v1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "failure_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "change_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "classification": {
      "const": "test_defect"
    },
    "review_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "review_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "kind": {
          "const": "human"
        }
      }
    },
    "reviewed_at": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "reason": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "proposal_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "original_requested_envelope_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "original_started_envelope_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "original_baseline_envelope_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "current_git_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "approved_snapshot_id": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "approved_snapshot_hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "replacement_scope_digest": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "superseded_repair_link": {
      "$ref": "repair-link.schema.json"
    }
  }
}
