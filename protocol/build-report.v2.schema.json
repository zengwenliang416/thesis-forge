{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesisforge.local/protocol/build-report.v2.schema.json",
  "title": "ThesisForge BuildReport v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildId",
    "intent",
    "outcome",
    "stages",
    "failedStage",
    "primaryDiagnosticId",
    "diagnostics",
    "logs",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "const": "thesisforge.build-report.v2"
    },
    "buildId": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": ["publish", "live-preview"]
    },
    "outcome": {
      "enum": ["succeeded", "failed", "canceled"]
    },
    "startedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "failedStage": {
      "anyOf": [
        {"$ref": "#/$defs/stageName"},
        {"type": "null"}
      ]
    },
    "primaryDiagnosticId": {
      "type": ["string", "null"]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "logs": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/logEntry"
      }
    },
    "output": {
      "anyOf": [
        {"$ref": "#/$defs/output"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "stageName": {
      "enum": [
        "parse",
        "validate",
        "compile",
        "render",
        "finalize",
        "postflight",
        "preview"
      ]
    },
    "stageStatus": {
      "enum": ["pending", "running", "succeeded", "failed", "skipped"]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": {"$ref": "#/$defs/stageName"},
        "status": {"$ref": "#/$defs/stageStatus"},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "completedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "startLine": {"type": "integer", "minimum": 1},
        "startColumn": {"type": ["integer", "null"], "minimum": 1},
        "endLine": {"type": ["integer", "null"], "minimum": 1},
        "endColumn": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "relatedLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "source"],
      "properties": {
        "message": {"type": "string"},
        "source": {"$ref": "#/$defs/sourceRange"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "category",
        "code",
        "stage",
        "message",
        "source",
        "target",
        "suggestion",
        "relatedLocations",
        "details"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "category": {
          "enum": [
            "project",
            "source",
            "semantic",
            "reference",
            "resource",
            "template",
            "compile",
            "docx",
            "office",
            "permission",
            "transport",
            "internal"
          ]
        },
        "code": {"type": "string", "pattern": "^TF-[A-Z0-9-]+$"},
        "stage": {"$ref": "#/$defs/stageName"},
        "message": {"type": "string", "minLength": 1},
        "source": {
          "anyOf": [
            {"$ref": "#/$defs/sourceRange"},
            {"type": "null"}
          ]
        },
        "target": {"type": ["string", "null"]},
        "suggestion": {"type": ["string", "null"]},
        "relatedLocations": {
          "type": "array",
          "items": {"$ref": "#/$defs/relatedLocation"}
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "logEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "stage", "level", "message"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "stage": {"$ref": "#/$defs/stageName"},
        "level": {"enum": ["debug", "info", "warning", "error"]},
        "message": {"type": "string", "maxLength": 4000}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "docxPath",
        "pdfPath",
        "previewStale",
        "successfulBuildId"
      ],
      "properties": {
        "docxPath": {"type": ["string", "null"]},
        "pdfPath": {"type": ["string", "null"]},
        "previewStale": {"type": "boolean"},
        "successfulBuildId": {"type": ["string", "null"]},
        "finalPreview": {
          "anyOf": [
            {"$ref": "#/$defs/finalPreview"},
            {"type": "null"}
          ]
        }
      }
    },
    "finalPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "label", "fileName"],
      "properties": {
        "engine": {
          "enum": ["microsoft-word", "libreoffice"]
        },
        "label": {
          "enum": ["Microsoft Word PDF", "LibreOffice PDF"]
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        },
        "downloadId": {
          "type": "string",
          "minLength": 1
        },
        "authorizationId": {
          "type": "string",
          "minLength": 1
        },
        "livePreviewId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
