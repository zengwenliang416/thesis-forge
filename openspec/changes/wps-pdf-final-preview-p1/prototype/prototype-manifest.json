{
  "schema": "specnav.prototype.manifest.v1",
  "version": "1",
  "type": "ui-html",
  "entry": "artifact/index.html",
  "variant": "dual-preview-final-layout-v1",
  "mock_strategy": "interactive static state fixtures modelled from the current ThesisForge workbench; no real PDF or production edits",
  "touches_real_data": false,
  "may_promote": false,
  "promotion_requirement": "requires verifier-report.json, explicit user approval, and prototype handoff",
  "visual_context": {
    "required_for_ui_html": true,
    "inventory": "visual-inventory.json",
    "project_shell_required": true,
    "generic_shell_allowed": false
  },
  "dependencies": [],
  "referenced_foundation_specs": [
    "ui-design",
    "system-architecture",
    "frontend-backend-data-flow",
    "component-architecture"
  ],
  "referenced_requirements": [
    "requirements.md",
    "acceptance.md",
    "spec-map.json",
    "component-impact-map.json"
  ],
  "ui_capabilities": {
    "theme": {
      "support": "light-only",
      "modes": [
        "light"
      ],
      "toggle_in_prototype": false,
      "source": "openspec/specs/ui-design/design.md#Theme & Internationalization"
    },
    "i18n": {
      "enabled": false,
      "locales": [
        "none"
      ],
      "default_locale": "none",
      "locale_switch_in_prototype": false,
      "fixed_product_copy_locale": "zh-CN",
      "source": "openspec/specs/ui-design/design.md#Theme & Internationalization"
    }
  },
  "verification": {
    "command": "OPENSPEC_TELEMETRY=0 openspec validate wps-pdf-final-preview-p1 --strict --no-interactive --json",
    "output": "verifier-report.json"
  }
}
