{
  "touched_specs": [
    "ui-design",
    "system-architecture",
    "frontend-backend-data-flow",
    "component-architecture"
  ],
  "ui_rules": [
    "no-production-ui-in-v1-core",
    "review-prototype:ui-html",
    "prototype-workbench:outline-editor-preview-diagnostics-template-build",
    "prototype-states:populated-loading-empty-error-disabled-permission",
    "cli-copy:zh-CN",
    "future-ui-reuses-core-services",
    "prototype:desktop-mobile"
  ],
  "architecture_modules": [
    "core-domain",
    "markdown-parser",
    "validator",
    "template-model",
    "compiler",
    "render-plan",
    "docx-renderer",
    "bibliography",
    "cli"
  ],
  "api_contracts": [
    "parse_markdown(path)->ThesisDocument",
    "validate_document(document,context)->ValidationIssue[]",
    "load_template(path)->ThesisTemplate",
    "compile_document(document,template,bibliography)->RenderPlan",
    "DocxRenderer.render(plan,output)->Path",
    "cli:inspect",
    "cli:validate",
    "cli:build"
  ],
  "database_entities": [
    "none:v1-local-files-only"
  ],
  "permissions": [
    "os-file-permissions-only",
    "inputs-read-only",
    "write-explicit-output-only",
    "no-secret-required-for-core"
  ],
  "operational_constraints": [
    "offline-first",
    "deterministic-build",
    "python-3.11-plus",
    "no-network-or-api-key-for-core",
    "atomic-output-replacement",
    "ooxml-structure-verification",
    "manual-office-client-review"
  ],
  "data_flows": [
    "FLOW-INSPECT",
    "FLOW-VALIDATE",
    "FLOW-BUILD"
  ],
  "theme_modes": [
    "light-only",
    "theme-toggle:none",
    "prototype:light"
  ],
  "locale_policy": [
    "i18n:disabled",
    "locales:zh-CN",
    "default-locale:zh-CN"
  ],
  "unresolved_gaps": []
}
