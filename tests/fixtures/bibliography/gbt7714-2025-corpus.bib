% =============================================================================
% GB/T 7714-2025 引用格式 golden corpus（V1 Phase 0 spike）
%
% 设计目标：覆盖 GB/T 7714-2025 常见文献类型与边界情形，用于对比
%   - pandoc --citeproc（Haskell citeproc）
%   - citeproc-py
%   - ThesisForge 手写 Gbt7714Formatter（仅 article/book/inproceedings/
%     mastersthesis/phdthesis）
%
% 说明：
%   - 采用 biblatex 扩展字段（date/urldate/entrysubtype/langid/eventtitle），
%     经典 BibTeX 工具可能忽略这些字段；
%   - langid={english} 用于标记西文条目，检验引擎是否按条目语言切换
%     "等/et al" 与标点（实证：pandoc citeproc 固定使用样式 default-locale）；
%   - 每条前的 % 注释说明该条的覆盖点。
% =============================================================================

% ---- 期刊文章 [J] -----------------------------------------------------------

% 覆盖点：中文期刊、3 著者（不触发"等"截断）、卷(期):页、含 DOI
@article{zh-article-3,
  author  = {王晓明 and 李红霞 and 陈志强},
  title   = {深度学习在医学影像分析中的应用},
  journal = {中华放射学杂志},
  year    = {2024},
  volume  = {58},
  number  = {3},
  pages   = {245--252},
  doi     = {10.3760/cma.j.cn112149-20240115-00032}
}

% 覆盖点：中文期刊、5 著者（>3，应触发"等"截断为前 3 名）
@article{zh-article-etal,
  author  = {刘洋 and 赵敏 and 孙建国 and 周丽萍 and 吴国强},
  title   = {城市轨道交通客流预测方法综述},
  journal = {交通运输工程学报},
  year    = {2023},
  volume  = {23},
  number  = {4},
  pages   = {1--15}
}

% 覆盖点：西文期刊、4 著者（GB/T 7714 要求西文用 "et al"；
% 实证检验引擎是否按 langid 切换术语）
@article{en-article-etal,
  author  = {Smith, John and Doe, Jane and Roe, Richard and Poe, Ann},
  title   = {Deterministic Compilation of Academic Documents},
  journal = {Journal of Document Engineering},
  year    = {2024},
  volume  = {12},
  number  = {2},
  pages   = {101--118},
  langid  = {english}
}

% 覆盖点：西文期刊、2 著者、含 DOI
@article{en-article-doi,
  author  = {Brown, Alice and Green, Bob},
  title   = {Template Driven Rendering Pipelines},
  journal = {ACM Computing Surveys},
  year    = {2022},
  volume  = {54},
  number  = {7},
  pages   = {1--34},
  doi     = {10.1145/3512345},
  langid  = {english}
}

% 覆盖点：缺卷号（只有期号）
@article{zh-article-no-volume,
  author  = {陈思远},
  title   = {乡村教师队伍建设的路径分析},
  journal = {教育研究},
  year    = {2023},
  number  = {6},
  pages   = {88--95}
}

% 覆盖点：缺页码（有卷有期无页码）
@article{zh-article-no-pages,
  author  = {李冬梅 and 王海涛},
  title   = {新型储能材料研究进展},
  journal = {材料导报},
  year    = {2024},
  volume  = {38},
  number  = {11}
}

% 覆盖点：在线优先出版（无卷无期无页码，仅有年与 DOI）
@article{en-article-online-first,
  author  = {Miller, David},
  title   = {Citation Graph Analysis at Scale},
  journal = {Journal of Informetrics},
  year    = {2025},
  doi     = {10.1016/j.joi.2025.101555},
  langid  = {english}
}

% 覆盖点：中英文混合（中文著者 + 西文刊名与题名）
@article{mixed-article,
  author  = {张伟 and 李娜},
  title   = {An Efficient Algorithm for Bibliographic Parsing},
  journal = {Chinese Journal of Computers},
  year    = {2023},
  volume  = {46},
  number  = {9},
  pages   = {1901--1915}
}

% ---- 专著 [M] ---------------------------------------------------------------

% 覆盖点：中文专著、单著者
