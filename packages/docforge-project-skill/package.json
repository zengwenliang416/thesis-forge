{
  "name": "docforge-project-skill",
  "version": "0.1.0",
  "description": "Create a verified DocForge Project Format V1 directory from Markdown and local resources.",
  "type": "module",
  "bin": {
    "docforge-project-skill": "bin/docforge-project-skill.mjs"
  },
  "files": [
    "bin/",
    "docforge-project/SKILL.md",
    "docforge-project/LICENSE",
    "docforge-project/agents/",
    "docforge-project/manifest.json",
    "docforge-project/evals/",
    "docforge-project/references/",
    "docforge-project/security/",
    "docforge-project/scripts/",
    "docforge-project/tests/README.md",
    "docforge-project/reports/skill-ir.json",
    "docforge-project/reports/security_trust_report.json",
    "docforge-project/reports/security_trust_report.md",
    "docforge-project/reports/trust-supplement.md",
    "docforge-project/reports/output_quality_scorecard.json",
    "docforge-project/reports/output_quality_scorecard.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node --check bin/docforge-project-skill.mjs && node --check docforge-project/scripts/docforge-project.mjs && python3 docforge-project/scripts/docforge_project.py --help >/dev/null",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-skill",
    "codex",
    "docforge",
    "markdown"
  ],
  "license": "MIT",
  "author": "DocForge maintainers"
}
