{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThesisForge",
  "version": "0.1.0",
  "identifier": "com.thesisforge.workbench",
  "build": {
    "beforeDevCommand": "pnpm --dir frontend dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "pnpm --dir frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "DocForge - Markdown → Word 文档工坊",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; frame-src 'self' blob:; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "targets": ["app", "dmg", "msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "本地优先的 Markdown 转 Word 文档工坊",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    }
  }
}
