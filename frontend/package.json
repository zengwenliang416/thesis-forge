{
  "name": "@thesis-forge/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 127.0.0.1",
    "e2e": "playwright test",
    "e2e:tauri:windows": "wdio run e2e/tauri-windows.wdio.conf.ts",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p e2e/tsconfig.wdio.json --noEmit --pretty false"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@wdio/cli": "9.27.1",
    "@wdio/globals": "9.27.1",
    "@wdio/local-runner": "9.27.1",
    "@wdio/mocha-framework": "9.27.1",
    "@wdio/spec-reporter": "9.27.1",
    "@wdio/tauri-service": "1.2.0",
    "@wdio/types": "9.27.1",
    "jsdom": "30.0.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "webdriverio": "9.27.1"
  },
  "pnpm": {
    "overrides": {
      "@wdio/tauri-service>@wdio/native-utils": "2.5.0"
    }
  }
}
